    {
      "name": "POST /books (Valid Body - 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 28.50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        },
        "description": "Creates a new book with valid title, author, and price."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Returns success message and created book object\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.equal(\"Book created successfully\");",
              "    pm.expect(jsonData.book).to.be.an(\"object\");",
              "    pm.expect(jsonData.book.title).to.equal(\"Clean Code\");",
              "    pm.expect(jsonData.book.author).to.equal(\"Robert C. Martin\");",
              "    pm.expect(jsonData.book.price).to.equal(28.50);",
              "    pm.expect(jsonData.book.id).to.be.a(\"number\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
