      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET /books (Default Query)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        },
        "description": "Fetches books with default pagination (limit=10, offset=0), sorted by id ASC."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array of books\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.at.most(10);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /books (Search Query - search_q)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=The",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "search_q",
              "value": "The"
            }
          ]
        },
        "description": "Filters books whose titles contain 'The' using LIKE partial match."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"All returned books contain search string in title\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    jsonData.forEach(function(book) {",
              "        pm.expect(book.title.toLowerCase()).to.include(\"the\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /books (Sorting - order_by & order)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            }
          ]
        },
        "description": "Sorts books by price in descending order."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Books sorted in descending order of price\", function () {",
              "    var jsonData = pm.response.json();",
              "    for (var i = 0; i < jsonData.length - 1; i++) {",
              "        pm.expect(jsonData[i].price).to.be.at.least(jsonData[i + 1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /books (Pagination - limit & offset)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?limit=5&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "limit",
              "value": "5"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        },
        "description": "Retrieves the first page with exactly 5 book records."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returned count is exactly 5\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.equal(5);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /books (Price Range - min_price & max_price)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?min_price=10&max_price=15",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "min_price",
              "value": "10"
            },
            {
              "key": "max_price",
              "value": "15"
            }
          ]
        },
        "description": "Filters books whose price is between 10.00 and 15.00 inclusive."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Prices are within specified range [10, 15]\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.forEach(function(b) {",
              "        pm.expect(b.price).to.be.at.least(10);",
              "        pm.expect(b.price).to.be.at.most(15);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
